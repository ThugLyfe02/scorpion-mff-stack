# local environment (never the code)
.venv/
__pycache__/
*.pyc
.pytest_cache/

# the fleet's isolated build worktrees are machine state, not source
.worktrees/

# live runtime state: this is machine state, not source. The kill switch file is
# deliberately NOT ignored - an arm-blocking file must be visible in the tree.
live/fills.jsonl
live/heartbeat.json
# confirmed execution is runtime state too: the event log and its TCA export
live/execution.jsonl
live/executions.jsonl

# risk state is machine state: a persisted drawdown must not be committed
live/governor.json
live/governor.json.tmp
